{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"outDir": "out",
		"lib": [
			"ES2022"
		],
        "types": [
            "node",
            "mocha"
        ],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,   /* enable all strict type-checking options */
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"moduleResolution": "node16",
		"skipLibCheck": true,
		"noUnusedParameters": true	
	},
	"exclude": ["node_modules", ".vscode-test"]
}
